# ==============================================================================
# AGRI SHIELD — System Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
PROJECT_NAME="AGRI SHIELD"
API_V1_STR="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16 + PostGIS 3.4 or Supabase)
# ------------------------------------------------------------------------------
# Option A: Supabase Connection String (Recommended for Supabase)
# Copy from Supabase Dashboard -> Settings -> Database -> Connection String (URI / Session / Transaction pooler)
# DATABASE_URL=postgresql://postgres.iekecrgipogdkycreqbc:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Or direct:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.iekecrgipogdkycreqbc.supabase.co:5432/postgres

# Option B: Standard Local PostgreSQL / Docker
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agrishield_user
POSTGRES_PASSWORD=agrishield_secure_password
POSTGRES_DB=agrishield_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Supabase Project Credentials
SUPABASE_URL=https://iekecrgipogdkycreqbc.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. Cache & Message Broker (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Asynchronous Task Queue (Celery)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ------------------------------------------------------------------------------
# 5. Object Storage (MinIO / S3 Compatible)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin_user
MINIO_SECRET_KEY=minio_admin_secure_password
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET_RAW_IMAGERY=agrishield-raw-imagery
MINIO_BUCKET_ORTHOMOSAICS=agrishield-orthomosaics
MINIO_BUCKET_INDEX_RASTERS=agrishield-index-rasters
MINIO_BUCKET_MODELS=agrishield-model-artifacts

# ------------------------------------------------------------------------------
# 6. Security & Authentication
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-super-secret-hex-encoded-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 7. AI/ML & Geospatial Engine Settings
# ------------------------------------------------------------------------------
MODEL_WEIGHTS_DIR=./weights
DEVICE=cpu # 'cuda' for GPU, 'cpu' for standard environments
DEFAULT_CRS=EPSG:4326
CALCULATION_CRS=EPSG:3857
MAX_UPLOAD_SIZE_MB=2048

# ------------------------------------------------------------------------------
# 8. Frontend Settings (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8001/api/v1
VITE_MAPTILER_API_KEY=
VITE_MAPBOX_API_KEY=

# ------------------------------------------------------------------------------
# 9. SMTP Email Delivery Configuration (Forgot Password & Email OTP)
# ------------------------------------------------------------------------------
# Obtain App Password from Google Account Security -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_TLS=true
EMAILS_FROM_EMAIL=your-email@gmail.com
EMAILS_FROM_NAME=AGRI SHIELD Security

# ------------------------------------------------------------------------------
# 10. Google OAuth 2.0 Credentials (Google Sign-In)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI MUST match: http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ------------------------------------------------------------------------------
# 11. SMS Provider Credentials (Phone Sign-In OTP)
# ------------------------------------------------------------------------------
# Option A: Twilio (https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option B: Fast2SMS (https://www.fast2sms.com/dashboard)
FAST2SMS_API_KEY=

# Option C: MSG91 (https://msg91.com/in/)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ------------------------------------------------------------------------------
# 12. Weather API Settings
# ------------------------------------------------------------------------------

# Primary provider: IMD (India Meteorological Department) — AUTHORITATIVE
# IMD API access requires official registration with India Meteorological Department.
# See: https://mausam.imd.gov.in/  |  Contact: imd@imd.gov.in
# Leave blank to automatically use Open-Meteo fallback.
IMD_API_BASE_URL=
IMD_API_KEY=
IMD_STATION_DATASET=observations

# Fallback provider: Open-Meteo — FREE, no API key required.
# Automatically used when IMD_API_KEY is not set.
# Docs: https://open-meteo.com/en/docs
AGRISHIELD_WEATHER_PROVIDER=open_meteo

# Legacy AccuWeather key (kept for backward compatibility)
ACCUWEATHER_API_KEY=<your-accuweather-api-key-here>

# Weather Cache TTL (seconds)
# Prevents hammering external APIs on every dashboard render.
CURRENT_WEATHER_CACHE_TTL=1800      # 30 minutes
FORECAST_CACHE_TTL=10800            # 3 hours
HISTORICAL_WEATHER_CACHE_TTL=21600  # 6 hours

