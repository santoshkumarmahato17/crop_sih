# ==============================================================================
# AGRI SHIELD — System Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
PROJECT_NAME="AGRI SHIELD"
API_V1_STR="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16 + PostGIS 3.4)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agrishield_user
POSTGRES_PASSWORD=agrishield_secure_password
POSTGRES_DB=agrishield_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ------------------------------------------------------------------------------
# 3. Cache & Message Broker (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Asynchronous Task Queue (Celery)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ------------------------------------------------------------------------------
# 5. Object Storage (MinIO / S3 Compatible)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin_user
MINIO_SECRET_KEY=minio_admin_secure_password
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET_RAW_IMAGERY=agrishield-raw-imagery
MINIO_BUCKET_ORTHOMOSAICS=agrishield-orthomosaics
MINIO_BUCKET_INDEX_RASTERS=agrishield-index-rasters
MINIO_BUCKET_MODELS=agrishield-model-artifacts

# ------------------------------------------------------------------------------
# 6. Security & Authentication
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-super-secret-hex-encoded-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 7. AI/ML & Geospatial Engine Settings
# ------------------------------------------------------------------------------
MODEL_WEIGHTS_DIR=./weights
DEVICE=cpu # 'cuda' for GPU, 'cpu' for standard environments
DEFAULT_CRS=EPSG:4326
CALCULATION_CRS=EPSG:3857
MAX_UPLOAD_SIZE_MB=2048

# ------------------------------------------------------------------------------
# 8. Frontend Settings (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAPTILER_API_KEY=
VITE_MAPBOX_API_KEY=

# ------------------------------------------------------------------------------
# 9. Weather API Settings
# ------------------------------------------------------------------------------
# AccuWeather API key — register at https://developer.accuweather.com/
# Keep this ONLY in backend .env — NEVER in frontend code or committed source
ACCUWEATHER_API_KEY=<your-accuweather-api-key-here>

# Weather provider: accuweather | open_meteo | mock
# Set to 'accuweather' for real-time GPS-based weather on the Farmer Dashboard
# Set to 'open_meteo' for a free fallback (no API key required)
# Set to 'mock' for offline development and testing
AGRISHIELD_WEATHER_PROVIDER=accuweather
