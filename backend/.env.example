# ==============================================================================
# AGRI SHIELD — Backend Environment Configuration Reference (.env.example)
# ==============================================================================

PROJECT_NAME="AGRI SHIELD"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_STR="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL + PostGIS or SQLite Fallback)
# ------------------------------------------------------------------------------
# For production PostgreSQL / Supabase, supply DATABASE_URL:
# DATABASE_URL=postgresql://user:password@localhost:5432/agrishield_db
USE_SQLITE_FALLBACK=true

# ------------------------------------------------------------------------------
# 2. Security & JWT Settings
# ------------------------------------------------------------------------------
SECRET_KEY="agrishield-dev-secret-key-replace-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. SMTP Email Delivery Credentials (REQUIRED FOR LIVE EMAIL OTPS)
# ------------------------------------------------------------------------------
# Obtain from your email provider (e.g., Gmail App Password or SendGrid / AWS SES)
# Gmail setup: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_TLS=true
EMAILS_FROM_EMAIL=your.email@gmail.com
EMAILS_FROM_NAME="AGRI SHIELD Security"

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 Credentials (REQUIRED FOR LIVE GOOGLE SIGN-IN)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 1. Create a project in Google Cloud Console.
# 2. Go to APIs & Services -> OAuth consent screen and configure User Type (External).
# 3. Go to Credentials -> Create Credentials -> OAuth client ID.
# 4. Select Application type: Web application.
# 5. Add Authorized JavaScript origins: http://localhost:5173
# 6. Add Authorized redirect URIs: http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# ------------------------------------------------------------------------------
# 5. SMS Provider Credentials (REQUIRED FOR LIVE PHONE OTP SMS)
# ------------------------------------------------------------------------------
# Option A: Twilio (https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Option B: Fast2SMS (https://www.fast2sms.com/dev/bulkV2)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Option C: MSG91 (https://msg91.com)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

SMS_PROVIDER=twilio


# ------------------------------------------------------------------------------
# 6. External Weather API (OpenWeatherMap / IMD)
# ------------------------------------------------------------------------------
# Obtain key from OpenWeatherMap: https://home.openweathermap.org/api_keys
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5
